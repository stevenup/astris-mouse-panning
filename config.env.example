# 复制为 config.env 后按需修改；run.sh 启动时自动读取。
# 所有值都有默认，不写即用默认。

# 切换平移的热键（修饰键 + 按键）。默认 cmd+alt+m，避免与 MacRMB 的 ⌥⌘P 冲突。
# 可用修饰键：cmd alt ctrl shift；按键：a-z 0-9 f1-f12 space tab esc，或直接写 keyCode 数字。
#export ASTRIS_MOUSE_TOGGLE="cmd+alt+m"

# 鼠标速度多少 pt/s 时右摇杆满偏。数值越小越灵敏。默认 400。
#export ASTRIS_MOUSE_FULL_SPEED=400

# 响应曲线指数。1 = 线性；1.5~2 时慢速更细腻、快速仍能满偏。默认 1。
#export ASTRIS_MOUSE_CURVE=1

# 低通平滑时间常数（毫秒）。越大越顺滑但越"飘"，越小越跟手。默认 20。
#export ASTRIS_MOUSE_SMOOTHING_MS=20

# 速度估计窗口（毫秒）。125Hz 鼠标建议 24~32，1000Hz 鼠标可降到 8~12。默认 24。
#export ASTRIS_MOUSE_WINDOW_MS=24

# 抗死区：对应 Astris 输入设置里的右摇杆死区（默认 0.1），让微小移动也能被游戏识别。默认 0.10。
#export ASTRIS_MOUSE_ANTI_DEADZONE=0.10

# 低于该幅值直接输出 0，防止手抖漂移。默认 0.02。
#export ASTRIS_MOUSE_OUTPUT_DEADZONE=0.02

# 反转 Y 轴。默认 0。
#export ASTRIS_MOUSE_INVERT_Y=0

# 手动指定 libryujinx 的 controller 句柄。通常不需要：默认优先用 Astris 前端连上的、
# 与 Astris 输入设置里 Player1 同名的物理手柄，否则用本工具创建的虚拟手柄。
#export ASTRIS_MOUSE_CONTROLLER=0

# 接管 Player1：Astris 里 Player1 是 Keyboard（或选了手柄但没指定具体哪一个）时，
# 在内存里把交给 libryujinx 的配置改成「Gamepad + 虚拟手柄」，否则鼠标进不了游戏。
# 只改本进程内存里的那份配置，Astris 的设置界面和偏好文件不变。设为 0 则完全按 Astris 的设置来。默认 1。
#export ASTRIS_MOUSE_TAKEOVER=1

# 开关提示音。默认 1。
#export ASTRIS_MOUSE_SOUND=1

# 详细日志：记录前端的每一次按键/摇杆调用以及本工具向虚拟手柄的每次输出。排查问题时打开。默认 0。
#export ASTRIS_MOUSE_DEBUG=0

# 键盘按键映射不在这里配置：本工具直接读取 Astris「设置 → 输入」里 Player1 的键位
# （WASD/IJKL/ZXCV 等），在 Astris 里改完键位会自动生效。
